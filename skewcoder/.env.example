# Copy to ~/.config/skewcoder/.env on the machine that runs the pipeline or the job server (outside any synced or
# shared folder; a .env in the repo is never committed, see .gitignore, but a synced folder would still copy it).
# The website never sees any of this: the browser talks to the job server, and only the server talks to Anthropic.
SKEWCODER_BACKEND=api
ANTHROPIC_API_KEY=sk-ant-...
SKEWCODER_MAX_JOBS_PER_DAY=10
# SKEWCODER_ACCESS_TOKEN=a-long-random-string      # require it on POST /jobs
# SKEWCODER_ALLOWED_ORIGINS=https://your-site.example # the site allowed to call the server from a browser
# SKEWCODER_PUBLIC_URL=https://…                    # the address the site reaches the server at
